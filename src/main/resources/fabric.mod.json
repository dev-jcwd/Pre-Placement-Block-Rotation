{
  "schemaVersion": 1,
  "id": "rotationplacement",
  "version": "${version}",
  "name": "Rotation Placement",
  "description": "A QOL mod for pre-placement block rotation with a translucent preview.",
  "authors": [
    "jcwd"
  ],
  "contact": {},
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.rotationplacement.RotationPlacement"
    ],
    "client": [
      "com.rotationplacement.RotationPlacementClient"
    ]
  },
  "mixins": [
    "rotationplacement.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-api": "*",
    "minecraft": "${mc_range}",
    "java": ">=${java_version}"
  }
}
